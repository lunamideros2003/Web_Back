# =============================================================================
#  Backend environment. Copy to `.env` and adjust.
#  Everything has a working default for local development, except Supabase.
# =============================================================================

# --- Process ----------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Leave empty in production: Render injects RENDER_INSTANCE_ID automatically.
INSTANCE_ID=
LOG_LEVEL=info
# pretty | json
LOG_FORMAT=pretty

# --- HTTP -------------------------------------------------------------------
# Comma separated list. Use the Vercel domain in production, e.g.
# CORS_ORIGIN=https://preconteo.vercel.app,http://localhost:5173
CORS_ORIGIN=*

# --- Redis (the only cross-instance coordination layer) ---------------------
# Local:  redis://127.0.0.1:6379
# Render: injected by the Blueprint (`fromService`), nothing to type.
# TLS:    rediss://default:<password>@<host>:<port>
REDIS_URL=redis://127.0.0.1:6379
# Only needed when REDIS_URL does not start with rediss:// but the endpoint needs TLS.
REDIS_TLS=false
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_COMMAND_TIMEOUT_MS=2000
REDIS_FAILURE_THRESHOLD=3
REDIS_CIRCUIT_COOLDOWN_MS=4000
# Namespace for every key this app owns.
KEY_PREFIX=preconteo

# --- Supabase (durable audit, optional but recommended) ---------------------
# Project Settings -> API -> Project URL
SUPABASE_URL=
# Project Settings -> API -> service_role secret. NEVER expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_WRITE_QUEUE_LIMIT=2000
SUPABASE_SNAPSHOT_INTERVAL_MS=30000

# --- Credentials ------------------------------------------------------------
# Jurors connect to /ws/jury?token=JURY_TOKEN
# Auditors connect to /ws/verification?token=AUDITOR_TOKEN&auditorId=...
# Demo HTTP endpoints require the x-admin-token header when ADMIN_TOKEN is set.
JURY_TOKEN=demo-jury-token
AUDITOR_TOKEN=demo-auditor-token
ADMIN_TOKEN=
# false => /metrics, /metrics/prometheus and /api/ops/metrics need x-admin-token
METRICS_PUBLIC=true
ENABLE_DEMO_ENDPOINTS=true

# --- Election reference dataset --------------------------------------------
ELECTION_MESAS=6400
ELECTION_PUESTOS=1842
ELECTION_MUNICIPIOS=11

# --- Aggregation window -----------------------------------------------------
# One published message per topic every 2s (instead of one per acta per client).
PUBLISH_WINDOW_MS=2000
PUBLISH_MAX_TOPICS=2000
PUBLISH_LEADER_TTL_MS=3000

# --- Replay history (Redis Streams) ---------------------------------------
HISTORY_MAX_ENTRIES=200
HISTORY_TTL_SECONDS=7200
HISTORY_REPLAY_MAX=400

# --- Fan-out and backpressure ---------------------------------------------
FANOUT_BATCH_SIZE=250
FANOUT_SLOW_BYTES=262144
FANOUT_CLOSE_BYTES=2097152
FANOUT_RESUME_BYTES=65536

# --- Limits and leases -----------------------------------------------------
JURY_ACTAS_PER_MINUTE=240
CONNECTION_RATE_LIMIT_PER_MINUTE=240
IDEMPOTENCY_TTL_SECONDS=86400
LOCK_LEASE_MS=60000
LOCK_RENEW_MS=20000
PRESENCE_TTL_SECONDS=45
PRESENCE_HEARTBEAT_MS=15000
PRESENCE_SWEEP_MS=5000

# --- Heartbeats and metrics ------------------------------------------------
WS_HEARTBEAT_MS=30000
SSE_HEARTBEAT_MS=15000
SSE_RETRY_MS=3000
METRICS_REPORT_MS=5000

# --- Demo / fault injection ------------------------------------------------
# Inflates published payloads (bytes) so the SSE backpressure policy is visible.
# Keep 0 outside a demo.
SSE_DEMO_PADDING_BYTES=0
